# =============================================================================
# Niran Sushi — variáveis de ambiente
# Copie este arquivo:  cp .env.example .env
# =============================================================================

# ── OBRIGATÓRIAS (aplicação não inicia sem estas) ────────────────────────────

# PostgreSQL (Neon, Supabase, Railway, local, etc.)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/niran_sushi

# Segredo do NextAuth — gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública da aplicação (dev local)
NEXTAUTH_URL=http://localhost:3000

# ── PAGAMENTOS (obrigatórias apenas em /api/pagamentos e webhooks MP) ───────

# Token de acesso Mercado Pago (painel → Credenciais)
MP_ACCESS_TOKEN=

# Segredo para validar assinatura HMAC dos webhooks MP
MP_WEBHOOK_SECRET=

# ── WORKERS / INTEGRAÇÕES (opcionais) ──────────────────────────────────────

# Segredo compartilhado entre Next.js e worker Railway
INTERNAL_API_SECRET=

# URL base do worker (ex.: https://seu-worker.up.railway.app)
RAILWAY_WORKER_URL=

# Token Focus NFe (emissão de nota fiscal)
FOCUS_NFE_TOKEN=

# WhatsApp (wppconnect)
WPP_SESSION=restaurante

# URL do cardápio público (links enviados no WhatsApp)
CARDAPIO_URL=cardapio.niransushi.com

# ── RUNTIME ──────────────────────────────────────────────────────────────────

# Porta do servidor Express (scripts/railway)
PORT=3001
